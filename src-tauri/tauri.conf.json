{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spend Better",
  "version": "1.1.0",
  "identifier": "io.github.fizzysoda711.spendbetter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Spend Better",
        "width": 8000,
        "height": 10000,
        "minWidth": 950,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
